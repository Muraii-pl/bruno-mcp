# Token tylko do odczytu repo z kolekcjami (Project access token z read_repository albo deploy token)
GITLAB_READ_TOKEN=
# Dla deploy tokena: jego nazwa użytkownika (dla project access token zostaw puste)
GITLAB_READ_USER=

# Opcjonalnie: konto techniczne dla run_endpoint, gdy developer nie poda własnych danych w nagłówkach
# (nazwy jak w {{process.env.X}} w Waszej kolekcji)
KC_USER=
KC_PASSWORD=
