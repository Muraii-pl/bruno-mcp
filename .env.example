# ---------- serwer (docker compose) ----------
# Obraz (domyślnie z GitLab Container Registry) i port na 127.0.0.1
BRUNO_MCP_IMAGE=registry.gitlab.twoja-firma.pl/platform/bruno-mcp:latest
BRUNO_MCP_PORT=3000

# ---------- GitLab ----------
GITLAB_URL=https://gitlab.twoja-firma.pl
GITLAB_PROJECT=platform/api-collections
TARGET_BRANCH=main
# Token tylko do odczytu repo z kolekcjami (Project access token z read_repository albo deploy token)
GITLAB_READ_TOKEN=
# Dla deploy tokena: jego nazwa użytkownika (dla project access token zostaw puste)
GITLAB_READ_USER=

# ---------- Bruno ----------
DEFAULT_RUN_ENV=dev
SESSION_IDLE_MINUTES=240

# Opcjonalnie: konto techniczne dla run_endpoint, gdy developer nie poda własnych danych w nagłówkach
# (nazwy jak w {{process.env.X}} w Waszej kolekcji)
KC_USER=
KC_PASSWORD=
